# Uncomment this line to define a global platform for your project
platform :ios, '14.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static

  # Pin gRPC versions for Xcode compatibility
  pod 'gRPC-C++', '1.57.0'
  pod 'gRPC-Core', '1.57.0'

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_phases.each do |phase|
      next unless phase.respond_to?(:files)

      phase.files.each do |file|
        settings = file.settings
        compiler_flags = settings && settings['COMPILER_FLAGS']
        next unless compiler_flags

        cleaned = compiler_flags.gsub(/\s*-GCC_WARN_INHIBIT_ALL_WARNINGS\s*/, ' ').squeeze(' ').strip
        if cleaned.empty?
          settings.delete('COMPILER_FLAGS')
        elsif cleaned != compiler_flags
          settings['COMPILER_FLAGS'] = cleaned
        end
      end
    end

    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      config.build_settings['OTHER_CFLAGS'] = '$(inherited) -std=gnu11 -Wno-error=unused-command-line-argument-hard-error-in-future'
      config.build_settings['OTHER_CPLUSPLUSFLAGS'] = '$(inherited) -std=gnu++17 -D_LIBCPP_ENABLE_CXX17_REMOVED_FEATURES=1 -Wno-error=unused-command-line-argument-hard-error-in-future'
      # Force C++17 standard and libc++ for gRPC/Abseil compatibility with Xcode 26.2
      config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'gnu++17'
      config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
      config.build_settings['GCC_C_LANGUAGE_STANDARD'] = 'gnu11'
      # Enable Abseil C++17 support and restore removed C++17 features for libc++
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = '$(inherited) ABSL_USES_CXX17=1 _LIBCPP_ENABLE_CXX17_REMOVED_FEATURES=1'
    end
  end
end
